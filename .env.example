# ==========================================
# CẤU HÌNH CÁC CỔNG DỊCH VỤ (SERVICE PORTS)
# ==========================================
# Cổng chạy ứng dụng Frontend
FRONTEND_PORT=3000

# Cổng chạy dịch vụ Backend API
BACKEND_PORT=8000

# Cổng chạy dịch vụ AI Service
AI_SERVICE_PORT=5000

# ==========================================
# CẤU HÌNH KẾT NỐI GIỮA CÁC DỊCH VỤ (URLS)
# ==========================================
# URL kết nối từ Client/Browser tới Backend API
NEXT_PUBLIC_API_URL=http://localhost:8000

# URL kết nối nội bộ từ Backend sang AI Service (Trong môi trường Docker)
AI_SERVICE_URL=http://ai-service:5000

# ==========================================
# CẤU HÌNH MÔI TRƯỜNG & LOGGING
# ==========================================
# Môi trường hoạt động: development | production | test
NODE_ENV=development
APP_ENV=development

# Mức độ ghi log: debug | info | warning | error
LOG_LEVEL=info

# Đường dẫn file mô hình AI (nếu dùng đường dẫn tùy chỉnh)
MODEL_PATH=ai-models/models/model.joblib